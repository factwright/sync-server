{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factwright-sync",
  "main": "worker/index.js",
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORES",
        "class_name": "UserStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "STORAGE_LIMIT_MB": "1024"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "factwright-sync",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "factwright-sync-files"
    }
  ]
}
